<?xml version="1.0" encoding="utf-8"?>
<!--
  Nexus PDF MSI (NexusOffices, by Sonnytech; based on PdfCraft). WiX Toolset v5
  (`dotnet tool install -g wix`). Built by package.ps1:

    wix build pdfcraft.wxs installer-ui.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d ModelsDir=... -d IconPath=... -o out.msi

  NexusOffices: the UpgradeCode, every explicit component GUID, the install folder, the ProgId, the
  context-menu verbs and every registry key are Nexus PDF's own (nexus/BRANDING_PATCH.md), so it
  installs and uninstalls next to an installed upstream app without upgrading, replacing or removing it.

  Per-machine install into Program Files, a Start Menu shortcut, a desktop shortcut (on by default,
  optional, and an update keeps it only if it is still there), an App Paths entry, Nexus PDF
  registered as a PDF handler (offered under "Open with" and in Default apps, never forced as the
  default), "Edit with Nexus PDF" on PDF files' right-click menu and "Create PDF with Nexus PDF…" on
  image files' right-click menu (both on by default, optional, and an update keeps the installed
  version's choice). Files opened with Nexus PDF arrive on its command line.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- NexusOffices: package.ps1 passes FontLicences=yes when it staged licenses\. Despite the name it
       covers every third-party licence text (font OFL texts, Lucide, Foxit, Adobe CMap); a build
       without that folder leaves the group out. -->
  <?ifndef FontLicences ?>
  <?define FontLicences = "no" ?>
  <?endif ?>
  <Package
      Name="Nexus PDF"
      Manufacturer="Sonnytech"
      Version="$(var.Version)"
      UpgradeCode="CA922A7F-167E-414E-86E2-875DF949BBFC"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Nexus PDF" Manufacturer="Sonnytech" />
    <!-- HKLM registrations must never point into a per-user installation (#305). Allow removal
         of an existing installation even if an older MSI let it install per-user. -->
    <Launch Condition="ALLUSERS = 1 OR (Installed AND REMOVE = &quot;ALL&quot;)"
        Message="Nexus PDF must be installed for all users. Run setup with administrator privileges and ALLUSERS=1; per-user installation is not supported." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Nexus PDF is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer requires an Icon id ending in .ico or .exe, or advertised shortcuts and
         Add/Remove Programs show a blank icon (#57). -->
    <Icon Id="PdfcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PdfcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/nhdai111983/pdfcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/nhdai111983/pdfcraft/releases" />
    <!-- Desktop shortcut (#143): on by default for a first install, a checkbox in the full-UI
         welcome dialog, and INSTALLDESKTOPSHORTCUT=0 on the msiexec command line for unattended
         installs. Secure, so the choice made in the (unelevated) UI reaches the elevated install.
         An update keeps the shortcut only if it is still on the desktop (#1058): the launcher
         updates with /passive and no properties, so deleting the shortcut is the only way its
         users can say no. A value given on the command line wins. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Secure="yes" />
    <Property Id="EXISTINGDESKTOPSHORTCUT">
      <DirectorySearch Id="DesktopSearch" Path="[DesktopFolder]" Depth="0">
        <FileSearch Name="Nexus PDF.lnk" />
      </DirectorySearch>
    </Property>
    <SetProperty Id="INSTALLDESKTOPSHORTCUT" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLDESKTOPSHORTCUT AND (NOT WIX_UPGRADE_DETECTED OR EXISTINGDESKTOPSHORTCUT)" />
    <!-- The File Explorer menus: "Edit with Nexus PDF" for PDF files (#682) and "Create PDF with
         Nexus PDF…" for images (#190). Each is on by default for a first install and has a property
         to leave it out of unattended installs: INSTALLPDFCONTEXTMENU=0 (also a welcome-dialog
         checkbox) and INSTALLIMAGECONTEXTMENU=0. Secure, like the desktop shortcut's.
         An update keeps the installed version's choice (#305) by looking for the menu's registry
         key, the way the desktop shortcut looks for its file: AppSearch runs before the old version
         is removed. Releases from before a menu existed (the PDF one came in 0.7.1, the image one in
         0.4.0) never had the key, so updating from one of them counts as a first install; the
         OnlyDetect rows below tell them apart. A value given on the command line wins. -->
    <Upgrade Id="CA922A7F-167E-414E-86E2-875DF949BBFC">
      <UpgradeVersion Minimum="0.7.1" IncludeMinimum="yes" OnlyDetect="yes" Property="PDFCONTEXTMENURELEASE" />
      <UpgradeVersion Minimum="0.4.0" IncludeMinimum="yes" OnlyDetect="yes" Property="IMAGECONTEXTMENURELEASE" />
    </Upgrade>
    <Property Id="INSTALLPDFCONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGPDFCONTEXTMENU">
      <RegistrySearch Id="PdfContextMenuSearch" Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\NexusPDF.Edit" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLPDFCONTEXTMENU" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLPDFCONTEXTMENU AND (NOT PDFCONTEXTMENURELEASE OR EXISTINGPDFCONTEXTMENU)" />
    <Property Id="INSTALLIMAGECONTEXTMENU" Secure="yes" />
    <Property Id="EXISTINGIMAGECONTEXTMENU">
      <RegistrySearch Id="ImageContextMenuSearch" Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\NexusPDF.CreatePdf" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLIMAGECONTEXTMENU" Value="1" After="AppSearch" Sequence="first"
        Condition="NOT INSTALLIMAGECONTEXTMENU AND (NOT IMAGECONTEXTMENURELEASE OR EXISTINGIMAGECONTEXTMENU)" />
    <UIRef Id="PdfcraftInstallerUI" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Nexus PDF">
        <Directory Id="ModelsFolder" Name="models" />
        <?if $(var.FontLicences) = "yes" ?>
        <Directory Id="LicensesFolder" Name="licenses" />
        <?endif ?>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Nexus PDF" Level="1">
      <ComponentGroupRef Id="PdfcraftFiles" />
      <ComponentGroupRef Id="PdfcraftModels" />
      <?if $(var.FontLicences) = "yes" ?>
      <ComponentGroupRef Id="PdfcraftFontLicences" />
      <?endif ?>
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="PdfcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="PdfcraftApp" Guid="D114091A-AEAF-481B-B7B9-638670FF14E1">
        <File Id="PdfcraftExe" Source="$(var.BinDir)\nexus-pdf.exe" KeyPath="yes" />

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\nexus-pdf.exe" Value="[#PdfcraftExe]" Type="string" />

        <!-- PDF files (#107): Nexus PDF is offered under "Open with" and in Settings ▸ Default
             apps, through Windows' Default Programs registration (a ProgID, OpenWithProgids,
             Capabilities and RegisteredApplications). It never takes over an existing default:
             .pdf's own default value is left alone, and the user chooses. Without this, the only
             Nexus PDF entry to pick was the advertised Start Menu shortcut, which Windows can't
             run as a file handler ("This app can't run on your PC"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusPDF.Document" Value="PDF Document" Type="string" />
        <!-- A negative index selects the stable icon resource ID, rather than its position.
             Resource 1 is the app's lion; resource 2 is the PDF document (build.rs). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusPDF.Document\DefaultIcon" Value="&quot;[#PdfcraftExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusPDF.Document\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.pdf\OpenWithProgids" Name="Sonnytech.NexusPDF.Document" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-pdf.exe" Name="FriendlyAppName" Value="Nexus PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-pdf.exe\DefaultIcon" Value="&quot;[#PdfcraftExe]&quot;,-2" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-pdf.exe\SupportedTypes" Name=".pdf" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\nexus-pdf.exe\shell\open\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus PDF\Capabilities" Name="ApplicationName" Value="Nexus PDF" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus PDF\Capabilities" Name="ApplicationDescription" Value="Nexus PDF (NexusOffices): open-source PDF workbench" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus PDF\Capabilities" Name="ApplicationIcon" Value="[#PdfcraftExe],0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus PDF\Capabilities\FileAssociations" Name=".pdf" Value="Sonnytech.NexusPDF.Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="NexusPDF" Value="Software\Sonnytech\Nexus PDF\Capabilities" Type="string" />
      </Component>

      <!-- Shortcuts (#143) are plain links to nexus-pdf.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows can't
           use as a file handler (#107), and 0.2.1's advertised one went missing from the Start menu
           (#143). Each has its own component with an HKLM key path, so Windows Installer removes it
           on uninstall; in this per-machine package both folders are the all-users ones. -->
      <Component Id="PdfcraftStartMenuShortcut" Directory="ProgramMenuFolder" Guid="24AF82A2-A27C-4817-95DF-C779227B63A8">
        <Shortcut Id="StartMenuShortcut" Name="Nexus PDF" Description="Nexus PDF"
            Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PdfcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus PDF\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="PdfcraftDesktopShortcut" Directory="DesktopFolder" Guid="0F36E294-1953-45F5-A36C-364A78A9FAB7"
          Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="Nexus PDF" Description="Nexus PDF"
            Target="[#PdfcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PdfcraftIcon.ico" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus PDF\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- PDF context menu (#682): "Edit with Nexus PDF" opens the file in Nexus PDF whichever app is
           the default for .pdf, which it leaves alone (SystemFileAssociations, like the image
           menu). Several PDFs selected (up to 15, Windows' limit for this kind of entry) start one
           launch each, and the single-instance hand-off opens them as tabs of one window. On
           Windows 11 the entry is under "Show more options": the first-level menu only takes
           packaged apps' (IExplorerCommand) entries. Its own component with an HKLM key path, so
           INSTALLPDFCONTEXTMENU=0 leaves it out and uninstall removes it. -->
      <Component Id="PdfcraftPdfContextMenu" Guid="794DEC2C-BC7B-4D7B-8DAA-3D840BC8BD81"
          Condition="INSTALLPDFCONTEXTMENU = 1">
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\NexusPDF.Edit" Value="Edit with Nexus PDF" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\NexusPDF.Edit" Name="Icon" Value="&quot;[#PdfcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\NexusPDF.Edit" Name="MultiSelectModel" Value="Document" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.pdf\shell\NexusPDF.Edit\command" Value="&quot;[#PdfcraftExe]&quot; &quot;%1&quot;" Type="string" />
      </Component>

      <!-- Image context menu (#190): "Create PDF with Nexus PDF…" opens the DPI chooser, without
           changing image file defaults. Its own component with an HKLM key path, so
           INSTALLIMAGECONTEXTMENU=0 leaves it out and uninstall removes it. These rows were in
           PdfcraftApp up to 0.7.1; moving them is safe because MajorUpgrade removes the old version
           before installing (afterInstallValidate), so no old row is left behind. -->
      <Component Id="PdfcraftImageContextMenu" Guid="F289E511-669D-4966-B3E3-77A920CAC254"
          Condition="INSTALLIMAGECONTEXTMENU = 1">
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\NexusPDF.CreatePdf" Value="Create PDF with Nexus PDF…" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\NexusPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.png\shell\NexusPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\NexusPDF.CreatePdf" Value="Create PDF with Nexus PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\NexusPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpg\shell\NexusPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\NexusPDF.CreatePdf" Value="Create PDF with Nexus PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\NexusPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpeg\shell\NexusPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\NexusPDF.CreatePdf" Value="Create PDF with Nexus PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\NexusPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tif\shell\NexusPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\NexusPDF.CreatePdf" Value="Create PDF with Nexus PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\NexusPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.tiff\shell\NexusPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\NexusPDF.CreatePdf" Value="Create PDF with Nexus PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\NexusPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.gif\shell\NexusPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\NexusPDF.CreatePdf" Value="Create PDF with Nexus PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\NexusPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.bmp\shell\NexusPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\NexusPDF.CreatePdf" Value="Create PDF with Nexus PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\NexusPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jp2\shell\NexusPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\NexusPDF.CreatePdf" Value="Create PDF with Nexus PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\NexusPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.j2k\shell\NexusPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\NexusPDF.CreatePdf" Value="Create PDF with Nexus PDF…" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\NexusPDF.CreatePdf" Name="MultiSelectModel" Value="Single" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\.jpx\shell\NexusPDF.CreatePdf\command" Value="&quot;[#PdfcraftExe]&quot; --create-images &quot;%1&quot;" Type="string" />
      </Component>

      <Component Id="PdfcraftCli">
        <File Id="PdfcraftCliExe" Source="$(var.BinDir)\nexus-pdf-cli.exe" KeyPath="yes" />
      </Component>
      <!-- The embedded PDF icon's ISC notice and project licences travel with the binaries. -->
      <Component Id="PdfcraftDocumentIconLicense">
        <File Id="PdfcraftDocumentIconLicenseFile" Source="$(var.BinDir)\LICENSE-document.txt" KeyPath="yes" />
      </Component>
      <Component Id="PdfcraftMitLicense">
        <File Id="PdfcraftMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="PdfcraftApacheLicense">
        <File Id="PdfcraftApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="PdfcraftNotice">
        <File Id="PdfcraftNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <!-- NexusOffices: ATTRIBUTION.md (README and NOTICE point to it), auto GUID. -->
      <Component Id="PdfcraftAttribution">
        <File Id="PdfcraftAttributionFile" Source="$(var.BinDir)\ATTRIBUTION.md" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- OCR models (#103), with their licences and ATTRIBUTION.txt, in models\ beside nexus-pdf.exe
         where the app looks for them: every file `cargo xtask models` fetched (package.ps1), one
         component each, so new models ship without naming them here. -->
    <ComponentGroup Id="PdfcraftModels" Directory="ModelsFolder">
      <Files Include="$(var.ModelsDir)\*" />
    </ComponentGroup>
    <?if $(var.FontLicences) = "yes" ?>
    <!-- NexusOffices: every third-party licence text (font OFL texts, Lucide, Foxit, Adobe CMap),
         staged by package.ps1 in licenses\, one auto-GUID component each. -->
    <ComponentGroup Id="PdfcraftFontLicences" Directory="LicensesFolder">
      <Files Include="$(var.BinDir)\licenses\*" />
    </ComponentGroup>
    <?endif ?>
  </Fragment>
</Wix>
